<UserControl x:Class="ApexConfigTool.Views.GraphicsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="34">

            <TextBlock Text="Graphics"
                       Style="{StaticResource PageTitleStyle}"
                       Margin="0,0,0,28"/>


            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Textures"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,15"/>


                        <TextBlock Text="Streaming budget"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <ComboBox x:Name="TextureBudgetCombo"
                                  Margin="0,5,0,14">

                            <ComboBoxItem Content="Keep current" Tag="__KEEP__"/>
                            <ComboBoxItem Content="None" Tag="0"/>
                            <ComboBoxItem Content="Very low" Tag="160000"/>
                            <ComboBoxItem Content="Low" Tag="300000"/>
                            <ComboBoxItem Content="Medium" Tag="600000"/>
                            <ComboBoxItem Content="High" Tag="1000000"/>
                            <ComboBoxItem Content="Very high" Tag="2000000"/>
                            <ComboBoxItem Content="Ultra" Tag="3000000"/>

                        </ComboBox>


                        <TextBlock Text="Filtering"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <ComboBox x:Name="TextureFilteringCombo"
                                  Margin="0,5,0,14">

                            <ComboBoxItem Content="Keep current" Tag="__KEEP__"/>
                            <ComboBoxItem Content="Bilinear" Tag="0"/>
                            <ComboBoxItem Content="Trilinear" Tag="1"/>
                            <ComboBoxItem Content="Anisotropic 2×" Tag="2"/>
                            <ComboBoxItem Content="Anisotropic 4×" Tag="4"/>
                            <ComboBoxItem Content="Anisotropic 8×" Tag="8"/>
                            <ComboBoxItem Content="Anisotropic 16×" Tag="16"/>

                        </ComboBox>


                        <TextBlock Text="Resolution"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <ComboBox x:Name="TextureResolutionCombo"
                                  Margin="0,5,0,0">

                            <ComboBoxItem Content="Keep current" Tag="__KEEP__"/>
                            <ComboBoxItem Content="Very low" Tag="2"/>
                            <ComboBoxItem Content="Low" Tag="1"/>
                            <ComboBoxItem Content="High" Tag="0"/>

                        </ComboBox>

                    </StackPanel>

                </Border>


                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Detail"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,15"/>


                        <TextBlock Text="Model detail"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <ComboBox x:Name="ModelDetailCombo"
                                  Margin="0,5,0,14">

                            <ComboBoxItem Content="Keep current" Tag="__KEEP__"/>
                            <ComboBoxItem Content="Lowest" Tag="0.600000"/>
                            <ComboBoxItem Content="Low" Tag="0.800000"/>
                            <ComboBoxItem Content="Medium" Tag="1"/>
                            <ComboBoxItem Content="High" Tag="2"/>

                        </ComboBox>


                        <TextBlock Text="Particles"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <ComboBox x:Name="ParticleQualityCombo"
                                  Margin="0,5,0,14">

                            <ComboBoxItem Content="Keep current" Tag="__KEEP__"/>
                            <ComboBoxItem Content="Low" Tag="0"/>
                            <ComboBoxItem Content="Medium" Tag="1"/>
                            <ComboBoxItem Content="High" Tag="2"/>

                        </ComboBox>


                        <TextBlock Text="Ragdolls"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <ComboBox x:Name="RagdollCountCombo"
                                  Margin="0,5,0,14">

                            <ComboBoxItem Content="Keep current" Tag="__KEEP__"/>
                            <ComboBoxItem Content="Low" Tag="0"/>
                            <ComboBoxItem Content="Medium" Tag="4"/>
                            <ComboBoxItem Content="High" Tag="8"/>

                        </ComboBox>


                        <TextBlock Text="World decals"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <ComboBox x:Name="DecalsCombo">

                            <ComboBoxItem Content="Keep current" Tag="__KEEP__"/>
                            <ComboBoxItem Content="Off" Tag="0"/>
                            <ComboBoxItem Content="On" Tag="256"/>

                        </ComboBox>

                    </StackPanel>

                </Border>

            </Grid>


            <Grid Margin="0,16,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Rendering"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,15"/>


                        <TextBlock Text="Anti-aliasing"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <ComboBox x:Name="AntiAliasingCombo"
                                  Margin="0,5,0,14">

                            <ComboBoxItem Content="Keep current" Tag="__KEEP__"/>
                            <ComboBoxItem Content="Off" Tag="0"/>
                            <ComboBoxItem Content="TSAA" Tag="12"/>

                        </ComboBox>


                        <TextBlock Text="VSync"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <ComboBox x:Name="VSyncCombo"
                                  Margin="0,5,0,14">

                            <ComboBoxItem Content="Keep current" Tag="__KEEP__"/>
                            <ComboBoxItem Content="Off" Tag="0"/>
                            <ComboBoxItem Content="On" Tag="1"/>

                        </ComboBox>


                        <TextBlock Text="Volumetric lighting"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <ComboBox x:Name="VolumetricLightingCombo"
                                  Margin="0,5,0,14">

                            <ComboBoxItem Content="Keep current" Tag="__KEEP__"/>
                            <ComboBoxItem Content="Off" Tag="0"/>
                            <ComboBoxItem Content="On" Tag="1"/>

                        </ComboBox>


                        <TextBlock Text="Volumetric fog"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <ComboBox x:Name="VolumetricFogCombo">

                            <ComboBoxItem Content="Keep current" Tag="__KEEP__"/>
                            <ComboBoxItem Content="Off" Tag="0"/>
                            <ComboBoxItem Content="On" Tag="1"/>

                        </ComboBox>

                    </StackPanel>

                </Border>


                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Advanced rendering"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,15"/>


                        <TextBlock Text="Dynamic resolution"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <ComboBox x:Name="DynamicResolutionCombo"
                                  Margin="0,5,0,14">

                            <ComboBoxItem Content="Keep current" Tag="__KEEP__"/>
                            <ComboBoxItem Content="Off" Tag="0"/>
                            <ComboBoxItem Content="On" Tag="1"/>

                        </ComboBox>


                        <TextBlock Text="Dynamic streaming"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <ComboBox x:Name="DynamicStreamingCombo"
                                  Margin="0,5,0,14">

                            <ComboBoxItem Content="Keep current" Tag="__KEEP__"/>
                            <ComboBoxItem Content="Off" Tag="0"/>
                            <ComboBoxItem Content="On" Tag="1"/>

                        </ComboBox>


                        <TextBlock Text="Ambient occlusion"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <ComboBox x:Name="AmbientOcclusionCombo"
                                  Margin="0,5,0,14">

                            <ComboBoxItem Content="Keep current" Tag="__KEEP__"/>
                            <ComboBoxItem Content="Off" Tag="0"/>
                            <ComboBoxItem Content="Low" Tag="1"/>
                            <ComboBoxItem Content="High" Tag="2"/>
                            <ComboBoxItem Content="Very high" Tag="3"/>
                            <ComboBoxItem Content="Ultra" Tag="4"/>

                        </ComboBox>


                        <TextBlock Text="Map detail"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <ComboBox x:Name="MapDetailCombo">

                            <ComboBoxItem Content="Keep current" Tag="__KEEP__"/>
                            <ComboBoxItem Content="Minimum" Tag="0"/>
                            <ComboBoxItem Content="Low" Tag="1"/>
                            <ComboBoxItem Content="High" Tag="2"/>

                        </ComboBox>

                    </StackPanel>

                </Border>

            </Grid>

        </StackPanel>

    </ScrollViewer>

</UserControl>