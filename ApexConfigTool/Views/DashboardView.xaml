<UserControl x:Class="ApexConfigTool.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="34">

            <TextBlock Text="Dashboard"
                       Style="{StaticResource PageTitleStyle}"
                       Margin="0,0,0,28"/>


            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Resolution"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <TextBlock x:Name="ResolutionText"
                                   Text="Unknown"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="FOV"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <TextBlock x:Name="FovText"
                                   Text="Default"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <Border Grid.Column="4"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="FPS limit"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <TextBlock x:Name="FpsText"
                                   Text="Default"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>


            <Grid Margin="0,14,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Apex"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <TextBlock x:Name="ApexStateText"
                                   Text="Unknown"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,9,0,0"/>

                    </StackPanel>

                </Border>


                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Launcher"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <TextBlock x:Name="LauncherText"
                                   Text="Unknown"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,9,0,0"/>

                    </StackPanel>

                </Border>


                <Border Grid.Column="4"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Protection"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <TextBlock x:Name="ReadOnlyText"
                                   Text="Unknown"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,9,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>


            <Border Style="{StaticResource CardStyle}"
                    Margin="0,16,0,0">

                <StackPanel>

                    <TextBlock Text="Video config"
                               Style="{StaticResource MutedTextStyle}"/>

                    <TextBlock x:Name="ConfigPathText"
                               Text="Not detected"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>