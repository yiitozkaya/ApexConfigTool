<UserControl x:Class="ApexConfigTool.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="34">

            <TextBlock Text="Profiles"
                       Style="{StaticResource PageTitleStyle}"
                       Margin="0,0,0,28"/>


            <Border Style="{StaticResource CardStyle}"
                    Margin="0,0,0,16">

                <StackPanel>

                    <TextBlock Text="Save profile"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,15"/>

                    <TextBox x:Name="ProfileNameBox"
                             Height="38"
                             Text="My Apex Profile"/>

                    <Button Content="Save current setup"
                            Width="150"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveProfileButton_Click"/>

                </StackPanel>

            </Border>


            <Border Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock Text="Saved profiles"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,15"/>

                    <ListBox x:Name="ProfileList"
                             Height="300"
                             DisplayMemberPath="DisplayText"/>

                    <WrapPanel Margin="0,14,0,0">

                        <Button Content="Load"
                                Width="90"
                                Margin="0,0,8,8"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="LoadProfileButton_Click"/>

                        <Button Content="Delete"
                                Width="90"
                                Margin="0,0,8,8"
                                Click="DeleteProfileButton_Click"/>

                        <Button Content="Refresh"
                                Width="90"
                                Margin="0,0,8,8"
                                Click="RefreshButton_Click"/>

                        <Button Content="Open folder"
                                Width="110"
                                Margin="0,0,8,8"
                                Click="OpenProfilesFolderButton_Click"/>

                    </WrapPanel>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>