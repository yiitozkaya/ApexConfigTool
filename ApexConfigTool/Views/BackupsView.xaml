<UserControl x:Class="ApexConfigTool.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="34">

            <TextBlock Text="Backups"
                       Style="{StaticResource PageTitleStyle}"
                       Margin="0,0,0,28"/>


            <Border Style="{StaticResource CardStyle}"
                    Margin="0,0,0,16">

                <StackPanel>

                    <TextBlock Text="Video config"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,15"/>

                    <ListBox x:Name="VideoBackupList"
                             Height="220"
                             DisplayMemberPath="DisplayText"/>

                    <WrapPanel Margin="0,14,0,0">

                        <Button Content="Restore"
                                Width="90"
                                Margin="0,0,8,8"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="RestoreVideoButton_Click"/>

                        <Button Content="Delete"
                                Width="90"
                                Margin="0,0,8,8"
                                Click="DeleteVideoButton_Click"/>

                        <Button Content="Open folder"
                                Width="110"
                                Margin="0,0,8,8"
                                Click="OpenVideoFolderButton_Click"/>

                    </WrapPanel>

                </StackPanel>

            </Border>


            <Border Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock Text="Autoexec"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,15"/>

                    <ListBox x:Name="AutoexecBackupList"
                             Height="220"
                             DisplayMemberPath="DisplayText"/>

                    <WrapPanel Margin="0,14,0,0">

                        <Button Content="Restore"
                                Width="90"
                                Margin="0,0,8,8"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="RestoreAutoexecButton_Click"/>

                        <Button Content="Delete"
                                Width="90"
                                Margin="0,0,8,8"
                                Click="DeleteAutoexecButton_Click"/>

                        <Button Content="Open folder"
                                Width="110"
                                Margin="0,0,8,8"
                                Click="OpenAutoexecFolderButton_Click"/>

                        <Button Content="Refresh"
                                Width="90"
                                Margin="0,0,8,8"
                                Click="RefreshButton_Click"/>

                    </WrapPanel>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>