<Window x:Class="ApexConfigTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apex Config"
        Width="1180"
        Height="760"
        MinWidth="1020"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="214"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- Sidebar -->

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <Grid Margin="14">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <StackPanel>

                    <!-- Logo -->

                    <Grid Margin="6,10,0,28">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <Border Width="32"
                                Height="32"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="8"
                                VerticalAlignment="Center">

                            <TextBlock Text="A"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="White"/>

                        </Border>


                        <TextBlock Grid.Column="1"
                                   Text="Apex Config"
                                   FontFamily="Segoe UI Variable Display"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>

                    </Grid>


                    <!-- Navigation -->

                    <RadioButton Content="Dashboard"
                                 GroupName="Navigation"
                                 IsChecked="True"
                                 Style="{StaticResource NavRadioButtonStyle}"
                                 Click="DashboardButton_Click"/>

                    <RadioButton Content="Display"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavRadioButtonStyle}"
                                 Click="DisplayButton_Click"/>

                    <RadioButton Content="Graphics"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavRadioButtonStyle}"
                                 Click="GraphicsButton_Click"/>

                    <RadioButton Content="Shadows"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavRadioButtonStyle}"
                                 Click="ShadowsButton_Click"/>

                    <RadioButton Content="Performance"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavRadioButtonStyle}"
                                 Click="PerformanceButton_Click"/>

                    <RadioButton Content="Autoexec"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavRadioButtonStyle}"
                                 Click="AutoexecButton_Click"/>

                    <RadioButton Content="Profiles"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavRadioButtonStyle}"
                                 Click="ProfilesButton_Click"/>

                    <RadioButton Content="Backups"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavRadioButtonStyle}"
                                 Click="BackupsButton_Click"/>

                    <RadioButton Content="Advanced"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavRadioButtonStyle}"
                                 Click="AdvancedButton_Click"/>

                </StackPanel>


                <!-- Bottom -->

                <StackPanel Grid.Row="2"
                            Margin="6,12">

                    <Border Style="{StaticResource StatusPillStyle}"
                            HorizontalAlignment="Left">

                        <TextBlock x:Name="ApexProcessText"
                                   Text="● Apex off"
                                   FontSize="11.5"
                                   Foreground="{StaticResource MutedTextBrush}"/>

                    </Border>


                    <TextBlock Text="v1.0"
                               Foreground="{StaticResource FaintTextBrush}"
                               FontSize="10.5"
                               Margin="10,8,0,0"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- Content -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="72"/>
            </Grid.RowDefinitions>


            <ContentControl x:Name="MainContent"
                            Grid.Row="0"/>


            <!-- Bottom actions -->

            <Border Grid.Row="1"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">

                <Grid Margin="22,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="12"/>


                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">

                        <Button Content="Backup"
                                Width="88"
                                Height="40"
                                Margin="4,0"
                                Click="BackupButton_Click"/>

                        <Button Content="Restore"
                                Width="88"
                                Height="40"
                                Margin="4,0"
                                Click="RestoreButton_Click"/>

                        <Button Content="Apply"
                                Width="105"
                                Height="40"
                                Margin="4,0"
                                Style="{StaticResource AccentOutlineButtonStyle}"
                                Click="ApplyButton_Click"/>

                        <Button Content="Apply &amp; launch"
                                Width="140"
                                Height="40"
                                Margin="4,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ApplyLaunchButton_Click"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>